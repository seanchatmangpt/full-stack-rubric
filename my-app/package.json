{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run serve:backend\" \"vite\"",
    "dev:interview": "concurrently \"npm run serve:interview\" \"vite\"",
    "serve:backend": "node backend.js",
    "serve:interview": "node backend-interview-copilot.js",
    "frontend": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:bdd": "vitest --config vitest.config.js src/test/features",
    "test:watch": "vitest --watch",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:component": "cypress run --component",
    "cypress:e2e": "cypress run --spec cypress/e2e/**/*.cy.js",
    "test:accessibility": "cypress run --spec cypress/e2e/**/*.cy.js --env ACCESSIBILITY=true",
    "test:performance": "cypress run --spec cypress/e2e/**/*.cy.js --env PERFORMANCE=true",
    "test:all": "npm run test:coverage && npm run cypress:run",
    "test:ci": "npm run test:coverage && npm run cypress:run --record",
    "test:parallel": "concurrently \"npm run test:coverage\" \"npm run cypress:component\"",
    "test:report": "npm run test:coverage && npm run cypress:run && node scripts/merge-reports.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^5.2.1",
    "@cypress/code-coverage": "^3.14.6",
    "@cypress/vite-dev-server": "^7.0.0",
    "@cypress/vue": "^6.0.2",
    "@tailwindcss/postcss": "^4.1.13",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/ui": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cypress": "^15.1.0",
    "cypress-axe": "^1.7.0",
    "cypress-terminal-report": "^7.2.1",
    "cypress-visual-regression": "^5.3.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
