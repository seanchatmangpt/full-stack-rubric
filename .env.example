# Environment Configuration Template
# Copy this to .env and configure for your deployment environment

# Application Environment
NODE_ENV=production
NUXT_HOST=0.0.0.0
NUXT_PORT=3000

# Domain and URLs
DOMAIN=example.com
API_BASE_URL=https://api.example.com

# Database Configuration
DATABASE_URL=postgresql://postgres:password@db:5432/nuxtapp
POSTGRES_DB=nuxtapp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PASSWORD=your_redis_password_here
REDIS_PORT=6379

# Security
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
BCRYPT_ROUNDS=12

# GitHub Container Registry (for CI/CD)
GITHUB_REPOSITORY=your-username/your-repo
GITHUB_TOKEN=ghp_your_github_token_here

# Monitoring
PROMETHEUS_PORT=9090

# Notifications (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# SSL/TLS (Production)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Performance Settings
MAX_UPLOAD_SIZE=16M
SESSION_TIMEOUT=3600
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Feature Flags
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true
ENABLE_RATE_LIMITING=true

# Third-party Services (if applicable)
# SENTRY_DSN=https://your-sentry-dsn
# STRIPE_PUBLISHABLE_KEY=pk_your_stripe_key
# STRIPE_SECRET_KEY=sk_your_stripe_secret